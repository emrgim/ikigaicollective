---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import InviteForm from '../components/InviteForm.astro';
import NoteCover from '../components/NoteCover.astro';
import { getNotes } from '../lib/notes';

const notes = await getNotes();
const recent = notes[notes.length - 1];
const faq = [
  { q: 'Do I need a project?', a: 'No. Bring a project, or just your curiosity.' },
  { q: 'Does it cost anything?', a: 'No. Participation is open and voluntary.' },
  { q: 'Where is it?', a: 'On Google Meet. The link is in the calendar invite.' },
  { q: 'What if I miss a week?', a: 'Every Lab Night becomes a Lab Note, so you can catch up and come the week after.' },
];
const hour = [
  ['FIRST HALF', 'A reflection, then a conversation', 'The night opens with a reflection on where AI and life design are heading, then opens up to everyone.'],
  ['SECOND HALF', 'Demos and builds', 'Members show what they made this week, ask for feedback, and get it honestly.'],
  ['THE CLOSE', 'A question for next week', 'Everyone leaves with a challenge to think about. The night becomes a Lab Note.'],
];
---
<Base title="Lab Night" description="Every Thursday, one hour, 21:00 Rome time. Members show the week's work, think out loud together and leave with a question." overlayNav>
  <section aria-labelledby="h1" class="relative overflow-hidden pt-[150px]">
    <div aria-hidden="true" class="absolute inset-0" style="background: radial-gradient(ellipse 70% 55% at 80% 110%, var(--copper-500) 0%, var(--copper-300) 18%, var(--copper-100) 40%, transparent 66%)"></div>
    <div class="wrap relative flex flex-wrap items-end gap-14 pb-[140px] pt-[100px] max-md:pb-20 max-md:pt-16">
      <div class="flex flex-[1_1_560px] flex-col gap-7">
        <span class="eyebrow">EVERY THURSDAY · ONE HOUR</span>
        <h1 id="h1" class="font-display text-[clamp(52px,10vw,150px)] font-normal leading-[1.02] pb-2">Lab <span class="em">Night</span></h1>
        <p class="max-w-[560px] text-[22px] leading-[1.55]">Members show the week's work, think out loud together and leave with a question. <span class="em">Bring a project, or just your curiosity.</span></p>
        <Button href="#invite" class="self-start">Get the invite</Button>
      </div>
      <div class="flex flex-[0_1_420px] flex-col gap-3.5 border border-cu-200 bg-card/80 p-8">
        <span class="text-[13px] tracking-[0.24em] text-muted">NEXT SESSION</span>
        <span class="font-display text-[30px]" data-ln-date>Thursday</span>
        <div data-ln-count hidden class="flex gap-[18px] tabular-nums">
          {[['d', 'days'], ['h', 'hours'], ['m', 'minutes']].map(([k, l]) => (
            <div><div class="num text-[52px] text-cu-900" {...{ [`data-ln-${k}`]: '' }}>00</div><div class="text-[13px] text-muted">{l}</div></div>
          ))}
        </div>
        <span class="border-t border-line pt-3.5 text-[16px]">21:00 Rome<span data-ln-local="sep" class="text-cu-800"></span> · Google Meet</span>
      </div>
    </div>
  </section>

  <Section bg="var(--night-2)" labelledby="h2" inner="flex flex-col gap-12">
    <span class="eyebrow">THE HOUR</span>
    <h2 id="h2" class="t-lg">What happens</h2>
    <ol class="m-0 flex list-none flex-wrap gap-0.5 border border-line bg-line p-0">
      {hour.map(([l, t, d]) => (
        <li class="flex min-h-[280px] flex-[1_1_300px] flex-col gap-3.5 px-8 py-10" style="background:var(--night-2)">
          <span class="text-[13px] tracking-[0.24em] text-muted">{l}</span>
          <h3 class="t-card">{t}</h3>
          <p class="text-[17px] leading-[1.6]">{d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section bg="var(--copper-100)" labelledby="h3" inner="flex flex-wrap items-center gap-14">
    <div class="flex-[1_1_480px] border border-cu-200"><NoteCover note={recent} widths={[480, 960]} sizes="(min-width: 1024px) 560px, 90vw" eager /></div>
    <div class="flex flex-[1_1_420px] flex-col gap-5">
      <span class="eyebrow text-cu-800">FROM A RECENT LAB NIGHT</span>
      <h2 id="h3" class="t-md">{recent.title}</h2>
      <p class="text-[19px] leading-[1.6]">Week {recent.week} · {recent.short}. {recent.excerpt}</p>
      <a href={`/lab-notes/${recent.slug}`} class="link-u self-start text-[16px]">Read the Lab Note</a>
    </div>
  </Section>

  <Section bg="var(--copper-200)" labelledby="h4" inner="flex flex-col gap-10">
    <span class="eyebrow text-cu-900">WHO COMES</span>
    <h2 id="h4" class="max-w-[1100px] font-display text-[clamp(32px,4.6vw,64px)] font-normal leading-[1.15]">People between things or restless, people with a <span class="italic text-cu-900">postponed project,</span> and people who want AI to increase their agency.</h2>
    <p class="text-[18px] text-cu-900">Designers, entrepreneurs, scientists, facilitators, strategists, builders. And a few agents.</p>
  </Section>

  <Section id="invite" bg="var(--copper-300)" labelledby="h5" inner="flex flex-wrap items-center gap-16">
    <div class="flex flex-[1_1_440px] flex-col gap-6">
      <span class="eyebrow text-paper">THE INVITE</span>
      <h2 id="h5" class="t-lg">Let your calendar<br /><span class="italic text-paper">do the remembering.</span></h2>
      <p class="text-[19px] leading-[1.6]">Sign up once and you get a weekly calendar invite with the Meet link. Other guests never see your email. Remove yourself any time.</p>
    </div>
    <InviteForm id="ln-invite" name success="Done. The invite is on its way. While you wait, read the latest Lab Note." />
  </Section>

  <Section theme="ikigai-dawn" bg="linear-gradient(180deg, var(--copper-900) 0%, var(--paper) 100%)" color="var(--ink)" labelledby="h6" max="960px" inner="flex flex-col gap-7">
    <span class="eyebrow text-cu-100">BEFORE YOU COME</span>
    <h2 id="h6" class="mb-3 font-display text-[clamp(36px,4vw,48px)] font-normal">Questions</h2>
    <Faq items={faq} qSize="24px" />
  </Section>

  <script>
    import '../scripts/forms';
  </script>
</Base>
