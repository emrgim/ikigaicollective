---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { IS_LIVE } from '../lib/env';

interface Props { title?: string; description?: string; overlayNav?: boolean; image?: string; canonical?: string }
const { overlayNav = false, image, canonical, title, description = 'Life design through experimentation. A weekly Lab Night for people building toward meaning.' } = Astro.props;
const full = title ? `${title} | Ikigai Collective` : 'Ikigai Collective';
---
<!doctype html>
<html lang="en" data-theme="ikigai-night">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Decide motion before first paint. No class = fully static page (also what no-JS visitors get).
      try {
        var d = document.documentElement; d.classList.add('js');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('rm');
        else {
          d.classList.add('motion');
          if (!sessionStorage.getItem('ik-draw')) { d.classList.add('draw-mark'); sessionStorage.setItem('ik-draw', '1'); }
        }
      } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!IS_LIVE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/charter-regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {IS_LIVE && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="5c467d4a-bf8a-42c0-a76b-a14753c54749" data-domains="ikigaicollective.org"></script>}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">Skip to content</a>
    <div class={overlayNav ? 'absolute inset-x-0 top-0 z-30' : 'relative z-30'}><Nav /></div>
    <main id="main"><slot /></main>
    <div id="sr-status" class="sr-only" role="status" aria-live="polite"></div>
    <Footer />
    <script>
      import { initLabNight } from '../lib/labnight-dom';
      initLabNight();
    </script>
    <script>
      import '../scripts/analytics';
    </script>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
