---
// Static in Phase 1. The endpoint, Turnstile and success state are wired in Phase 5.
interface Props { name?: boolean; intro?: string; foot?: string; success: string; id?: string }
const { name = false, intro, foot = 'Protected by an invisible spam check.', success, id = 'invite-form' } = Astro.props;
---
<form data-theme="ikigai-dawn" id={id} aria-labelledby={`${id}-h`} data-invite-form class="flex flex-[1_1_400px] flex-col gap-4 bg-bg p-8 text-fg shadow-[0_30px_80px_rgba(10,10,10,0.35)] md:p-11" method="post" action="/api/invite">
  <h3 id={`${id}-h`} class="font-display text-[34px] font-normal leading-tight">Get the invite</h3>
  {intro && <p class="text-[17px] leading-[1.55]">{intro}</p>}
  <div class="flex flex-col gap-2.5" data-invite-fields>
    {name && (<>
      <label for={`${id}-nm`} class="text-[15px]">First name</label>
      <input id={`${id}-nm`} name="name" type="text" autocomplete="given-name" class="field" />
    </>)}
    <label for={`${id}-em`} class="text-[15px]">Email</label>
    <input id={`${id}-em`} name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field" />
    <button type="submit" class="btn btn-ink mt-1.5 min-h-[52px] w-full text-[17px]">Send me the invite</button>
  </div>
  <p data-invite-success hidden class="border border-[var(--success)] p-4 text-[17px] leading-[1.5] text-[var(--success)]" role="status">{success}</p>
  <span class="text-[13px] text-muted">{foot}</span>
</form>
