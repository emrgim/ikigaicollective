---
import Mark from './Mark.astro';
import { NAV_LINKS } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const active = (href: string) => path === href || path.startsWith(href + '/');
---
<div class="drawer drawer-end relative z-20">
  <input id="nav-drawer" type="checkbox" class="drawer-toggle" tabindex="-1" aria-hidden="true" />
  <div class="drawer-content min-w-0">
    <header class="wrap flex items-center justify-between gap-x-8 py-6">
      <a href="/" class="hit flex items-center gap-3 no-underline text-copper" aria-label="Ikigai Collective, home">
        <Mark size={32} variant="small" draw={!isHome} />
        <span class="font-display text-[14px] tracking-[0.24em] text-fg">IKIGAI COLLECTIVE</span>
      </a>
      <nav aria-label="Main" class="hidden gap-x-8 text-[15px] lg:flex">
        {NAV_LINKS.map((l) => (
          <a
            href={l.href}
            aria-current={active(l.href) ? 'page' : undefined}
            class={`hit border-b pb-1 pt-2.5 no-underline text-fg hover:text-cu-900 ${active(l.href) ? 'border-copper' : 'border-transparent'}`}
          >{l.label}</a>
        ))}
      </nav>
      <a href="/join" class="btn btn-primary btn-sm hidden lg:inline-flex">Get the invite</a>
      <label
        for="nav-drawer"
        id="nav-open"
        role="button"
        tabindex="0"
        aria-label="Open menu"
        aria-controls="nav-menu"
        aria-expanded="false"
        class="btn btn-ghost btn-square lg:hidden"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </label>
    </header>
    <div class="flex justify-center px-4">
      <a
        href="/lab-night"
        id="nav-pill"
        class="flex max-w-full items-center gap-3 rounded-[22px] border border-cu-200 bg-card/75 px-[18px] py-2.5 text-[14px] no-underline text-fg hover:text-cu-900"
      >
        <span class="size-2 shrink-0 rounded-full bg-copper shadow-[0_0_10px_var(--accent)]" aria-hidden="true"></span>
        <span>Next Lab Night · <span data-ln-date>Thursday</span> · 21:00 Rome<span data-ln-local="sep" class="text-cu-700"></span></span>
      </a>
    </div>
  </div>
  <div class="drawer-side z-50">
    <label for="nav-drawer" aria-label="Close menu" class="drawer-overlay"></label>
    <div id="nav-menu" class="flex min-h-full w-80 max-w-[85vw] flex-col gap-2 bg-card p-6 text-[18px]">
      <button type="button" id="nav-close" class="btn btn-ghost btn-square self-end" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
      <nav aria-label="Mobile" class="flex flex-col">
        {NAV_LINKS.map((l) => (
          <a
            href={l.href}
            aria-current={active(l.href) ? 'page' : undefined}
            class={`border-b border-line py-4 no-underline text-fg ${active(l.href) ? 'text-copper' : ''}`}
          >{l.label}</a>
        ))}
      </nav>
      <a href="/join" class="btn btn-primary mt-4">Get the invite</a>
    </div>
  </div>
</div>

<script>
  // Drawer: toggle by keyboard, move focus into the menu, make the page inert while open.
  const box = document.getElementById('nav-drawer') as HTMLInputElement;
  const open = document.getElementById('nav-open')!;
  const content = document.querySelector('.drawer-content') as HTMLElement;
  const set = (on: boolean, restore = false) => {
    box.checked = on;
    open.setAttribute('aria-expanded', String(on));
    content.inert = on;
    if (on) document.getElementById('nav-close')!.focus();
    else if (restore) open.focus();
  };
  open.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(!box.checked); }
  });
  box.addEventListener('change', () => set(box.checked));
  document.getElementById('nav-close')!.addEventListener('click', () => set(false, true));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && box.checked) set(false, true);
  });
</script>
