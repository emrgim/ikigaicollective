---
import { Image } from 'astro:assets';
import { gradient, type Note } from '../lib/notes';
// Gradient by default. Pass `real` for the repo cover (featured note only): it carries the title in the image, so its alt is empty.
interface Props { note: Note; real?: boolean; widths?: number[]; sizes?: string; class?: string; eager?: boolean }
const { note, real, widths = [320, 640], sizes = '(min-width: 1024px) 300px, 90vw', class: cls = '', eager } = Astro.props;
---
{real && note.cover ? (
  <Image src={note.cover} alt="" widths={widths} sizes={sizes} format="webp" quality={70} class={`block aspect-video w-full object-cover ${cls}`} loading={eager ? 'eager' : 'lazy'} />
) : (
  <span aria-hidden="true" class={`block aspect-video w-full ${cls}`} style={`background:${gradient(note.index)}`}></span>
)}
