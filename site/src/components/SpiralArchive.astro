---
import { spiral } from '../lib/spiral';
import { gradient, type Note } from '../lib/notes';

// One point per note, oldest at the centre. Desktop: SVG spiral with 44px hit areas.
// Below 640px: horizontal timeline. Both use the same selectable card; without JS the points are plain links.
interface Props { notes: Note[] }
const { notes } = Astro.props;
const { pt, path } = spiral(400, 400, 12, 22);
const t0 = 1.4, step = 0.6, tEnd = t0 + step * (notes.length - 1);
const latest = notes[notes.length - 1];
const data = (n: Note, extra: Record<string, string | number> = {}) => ({
  'data-i': n.index, 'data-slug': n.slug, 'data-week': n.week, 'data-date': n.short, 'data-title': n.title, 'data-bg': gradient(n.index),
  'aria-label': `Week ${n.week}: ${n.title}, ${n.short}`, ...extra,
});
// Round hit area per point: up to 44px, shrunk so neighbours on the tight inner turns never overlap.
const pts = notes.map((n) => pt(t0 + step * n.index));
const gap = (i: number) => Math.min(...[pts[i - 1], pts[i + 1]].filter(Boolean).map((q) => Math.hypot(q[0] - pts[i][0], q[1] - pts[i][1])));
const hr = (i: number) => Math.max(11, Math.min(22, gap(i) * 0.8 * 0.5)).toFixed(1);
const sp = pt(tEnd);
let cx = sp[0] + 22; if (cx + 250 > 790) cx = sp[0] - 272;
let cy = Math.max(10, sp[1] - 90); if (cy + 240 > 790) cy = 550;
---
<div class="w-full max-w-[720px] lg:flex-[0_1_720px]" id="spiral">
  <!-- Spiral, 640px and up -->
  <div data-sp-group="spiral" role="group" aria-label={`Lab Notes spiral, ${notes.length} notes. Use the arrow keys to move between weeks.`} class="relative hidden aspect-square w-full overflow-hidden sm:block [@media(pointer:coarse)]:!hidden">
    <div aria-hidden="true" class="absolute inset-0 rounded-full" style="background: radial-gradient(circle, var(--copper-100) 0%, transparent 62%)"></div>
    <svg aria-hidden="true" viewBox="0 0 800 800" class="absolute inset-0 size-full">
      <path data-sp-line d={path(t0, tEnd)} pathLength="1" fill="none" stroke="var(--copper-400)" stroke-width="1.6" stroke-linecap="round" />
      <path d={path(tEnd, tEnd + 1.9)} fill="none" stroke="var(--copper-300)" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2 7" />
    </svg>
    {notes.map((n) => {
      const p = pt(t0 + step * n.index);
      return (
        <a href={`/lab-notes/${n.slug}`} {...data(n, { 'data-x': p[0].toFixed(1), 'data-y': p[1].toFixed(1) })} aria-current={n.index === latest.index ? 'true' : undefined}
          class="sp-dot absolute flex size-11 items-center justify-center rounded-full" data-latest={n.index === latest.index ? '' : undefined}
          style={`left:calc(${(p[0] / 8).toFixed(2)}% - 22px);top:calc(${(p[1] / 8).toFixed(2)}% - 22px);--hr:${hr(n.index)}px;z-index:${n.index + 1}`}>
          <span class="sp-dot-core block rounded-full"></span>
        </a>
      );
    })}
    <a data-sp-card aria-hidden="true" tabindex="-1" href={`/lab-notes/${latest.slug}`} class="pointer-events-none absolute z-[40] flex w-[31.25%] min-w-[190px] flex-col border border-cu-200 bg-card text-fg no-underline"
      style={`left:${(cx / 8).toFixed(2)}%;top:${(cy / 8).toFixed(2)}%`}>
      <span data-sp-art aria-hidden="true" class="block aspect-[250/140] w-full" style={`background:${gradient(latest.index)}`}></span>
      <span class="flex flex-col gap-1.5 px-4 pb-4 pt-3.5">
        <span class="text-[13px] text-muted"><span class="text-copper" data-sp-week>Week {latest.week}</span> · <span data-sp-date>{latest.short}</span></span>
        <span class="font-display text-[21px] leading-[1.25]" data-sp-title>{latest.title}</span>
      </span>
    </a>
  </div>

  <!-- Timeline, below 640px -->
  <div data-sp-group="timeline" class="sm:hidden [@media(pointer:coarse)]:!block">
    <ol data-lenis-prevent-wheel aria-label={`Lab Notes timeline, ${notes.length} weeks`} class="sp-tl-row flex w-full snap-x snap-mandatory overflow-x-auto pb-2">
      {notes.map((n) => (
        <li class="shrink-0 snap-center">
          <a href={`/lab-notes/${n.slug}`} {...data(n)} aria-current={n.index === latest.index ? 'true' : undefined} data-latest={n.index === latest.index ? '' : undefined}
            class="sp-tl relative flex h-[72px] min-w-12 flex-col items-center justify-center gap-1.5">
            <span class="sp-dot-core block rounded-full"></span>
            <span class="text-[13px] text-muted">{n.week}</span>
          </a>
        </li>
      ))}
    </ol>
    <a data-sp-card aria-hidden="true" tabindex="-1" href={`/lab-notes/${latest.slug}`} class="mt-6 flex w-full flex-col border border-cu-200 bg-card text-fg no-underline">
      <span data-sp-art aria-hidden="true" class="block aspect-video w-full" style={`background:${gradient(latest.index)}`}></span>
      <span class="flex flex-col gap-1.5 px-4 pb-4 pt-3.5">
        <span class="text-[13px] text-muted"><span class="text-copper" data-sp-week>Week {latest.week}</span> · <span data-sp-date>{latest.short}</span></span>
        <span class="font-display text-[21px] leading-[1.25]" data-sp-title>{latest.title}</span>
      </span>
    </a>
  </div>
</div>
