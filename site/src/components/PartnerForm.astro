---
// Partners page: "Start a conversation". Light glass card, type pills, and the enquiry as one sentence.
// Submission, honeypot, Turnstile and preview handling stay in scripts/forms.ts; the pills and sentence live in scripts/partner-form.ts.
import Agent from './footer/FooterAgent.astro';
import copy from '../content/site/copy.json';
const f = copy.partnerForm;
// value is what the API has always received for kind.
const kinds = [
  { value: 'Community', label: 'Community' },
  { value: 'AI tool', label: 'AI tool maker' },
  { value: 'Institution', label: 'Institution' },
];
---
<form aria-labelledby="fh" data-partner-form data-inline-errors novalidate method="post" action="/api/partner" class="pc">
  <h3 id="fh" class="pc-eyebrow">START A CONVERSATION</h3>
  <div data-partner-fields data-fade>
    <div class="pc-pills" role="radiogroup" aria-label="You are a">
      {kinds.map((k, i) => <button type="button" role="radio" class="pc-pill" data-kind={k.value} aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{k.label}</button>)}
    </div>
    <input type="hidden" name="kind" value="Community" data-kind-input />
    <p class="pc-s">
      Hi, we’re
      <span class="pc-nb"><span class="pc-w">
        <label for="pc-org" class="sr-only">Organisation</label>
        <input id="pc-org" name="org" type="text" required autocomplete="organization" maxlength="160" class="pc-f" data-pc data-need={f.needOrg} data-ph-org aria-describedby="pc-org-e" />
        <span id="pc-org-e" class="pc-err" hidden></span>
      </span>,</span> <span class="pc-nb" data-art>a community.</span>
      <br class="pc-br" />
      We’d love to try
      <span class="pc-w pc-wm">
        <label for="pc-msg" class="sr-only">Message</label>
        <textarea id="pc-msg" name="message" rows="1" required maxlength="4000" class="pc-f pc-msg" data-pc data-need={f.needMessage} data-ph-msg aria-describedby="pc-msg-e"></textarea>
        <span id="pc-msg-e" class="pc-err" hidden></span>
      </span>
      together. You can reach us at
      <span class="pc-w">
        <label for="pc-em" class="sr-only">Email</label>
        <input id="pc-em" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="254" class="pc-f" placeholder="you@organisation.org" data-pc data-need={f.needEmail} data-bad={f.badEmail} aria-describedby="pc-em-e" />
        <span id="pc-em-e" class="pc-err" hidden></span>
      </span>.
    </p>
    <div class="pc-foot">
      <span class="pc-note">
        <svg class="pc-agent" viewBox="-26 -92 52 102" width="40" aria-hidden="true"><Agent x={0} y={0} s={1} legs={8} arms={['M-23 -26 Q-31 -14 -27 -4']} /><path class="fs-st pw-arm" fill="none" d="M23 -26 Q31 -14 27 -4" /></svg>
        <span>{f.reassurance}</span>
      </span>
      <button type="submit" class="pc-btn" data-sending="Sending…">Start the conversation →</button>
    </div>
  </div>
  <div data-partner-success hidden role="status" tabindex="-1" class="pc-ok">
    <svg class="pc-agent pc-wave" viewBox="-26 -92 52 102" width="48" aria-hidden="true"><Agent x={0} y={0} s={1} legs={8} arms={['M-23 -26 Q-31 -14 -27 -4']} /><path class="fs-st pw-arm" fill="none" d="M23 -26 Q31 -14 27 -4" /></svg>
    <p>Thank you. We'll be in touch.</p>
  </div>
</form>

<style is:global>
  .pc { position: relative; padding: 44px 48px 40px; color: var(--ink); background: color-mix(in srgb, var(--paper) 58%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid rgb(255 255 255 / 0.6); border-radius: 28px; box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--copper-200) 45%, transparent); }
  .pc-eyebrow { margin: 0; font: inherit; font-size: 12px; letter-spacing: 0.3em; color: var(--copper-300); }
  .pc-pills { display: flex; flex-wrap: wrap; gap: 10px; margin: 22px 0 26px; }
  .pc-pill { min-height: 44px; padding: 8px 16px; border-radius: 9999px; font: inherit; font-size: 17px; cursor: pointer; color: var(--ink); background: rgb(255 255 255 / 0.35); border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); transition: background-color 0.15s, color 0.15s; }
  .pc-pill:hover { background: rgb(255 255 255 / 0.6); }
  .pc-pill[aria-checked='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .pc-pill:focus-visible, .pc-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .pc-s { margin: 0; font-size: 30px; line-height: 1.75; }
  .pc-nb { white-space: nowrap; }
  .pc-w { position: relative; display: inline-block; vertical-align: baseline; }
  .pc-wm { display: block; max-width: 540px; }
  .pc-f { display: inline-block; max-width: 100%; margin: 0; padding: 0 4px 2px; font: inherit; font-style: normal; line-height: 1.35; color: var(--ink); background: transparent; border: 0; border-bottom: 2px solid color-mix(in srgb, var(--ink) 45%, transparent); border-radius: 0; outline: 0; width: 240px; transition: border-color 0.15s; }
  @supports (field-sizing: content) { input.pc-f { field-sizing: content; width: auto; min-width: 220px; } }
  .pc-msg { display: block; width: 100%; resize: none; overflow: hidden; vertical-align: top; }
  .pc-f::placeholder { font-style: italic; color: color-mix(in srgb, var(--ink) 66%, transparent); opacity: 1; }
  .pc-f:focus { border-bottom-color: var(--ink); }
  .pc-f:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }
  .pc-f[aria-invalid='true'] { border-bottom-color: var(--danger); }
  .pc-w:has([aria-invalid='true']) { margin-bottom: 22px; }
  .pc-err { position: absolute; left: 4px; top: 100%; margin-top: -2px; font-size: 14px; line-height: 1.3; font-style: normal; color: color-mix(in srgb, var(--danger) 62%, var(--ink)); white-space: nowrap; }
  .pc-err[hidden] { display: none; }

  .pc-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-top: 36px; }
  .pc-note { display: flex; align-items: center; gap: 14px; font-size: 15px; line-height: 1.3; color: var(--muted); }
  .pc-agent { flex: none; height: auto; overflow: visible; }
  .pc .fs-bob { animation: none !important; }
  .pc-btn { display: inline-flex; min-height: 52px; align-items: center; justify-content: center; padding: 17px 30px; border: 0; border-radius: 9999px; font: inherit; font-size: 17px; cursor: pointer; color: var(--paper); background: var(--ink); transition: background-color 0.15s, opacity 0.15s; }
  .pc-btn:hover { background: color-mix(in srgb, var(--ink) 82%, var(--accent)); }
  .pc-btn:disabled { opacity: 0.7; cursor: progress; }
  .pc > [role='status']:not(.pc-ok) { margin: 18px 0 0; color: var(--ink); }

  .pc-ok { display: flex; align-items: center; gap: 36px; padding: 28px 0 8px; }
  .pc-ok p { margin: 0; font-size: 26px; line-height: 1.35; }
  .pc-ok:focus { outline: 0; }
  .pw-arm { transform-box: fill-box; transform-origin: 0 0; }
  [data-fade] { transition: opacity 0.2s ease; }
  [data-fade].is-out { opacity: 0; }
  html.motion .pc-ok:not([hidden]) { animation: pc-in 0.3s ease both; }
  html.motion .pc-ok:not([hidden]) .pw-arm { animation: pw-wave 1.6s ease-in-out 0.3s both; }
  @keyframes pc-in { from { opacity: 0; } }
  @keyframes pw-wave { 0% { transform: rotate(0); } 20% { transform: rotate(-135deg); } 35% { transform: rotate(-105deg); } 50% { transform: rotate(-135deg); } 65% { transform: rotate(-105deg); } 80% { transform: rotate(-135deg); } 100% { transform: rotate(0); } }

  @media (max-width: 767px) {
    .pc { padding: 28px 20px 24px; border-radius: 24px; }
    .pc-s { font-size: 22px; line-height: 1.5; }
    .pc-nb { white-space: normal; }
    .pc-w, .pc-wm { display: block; max-width: none; margin-block: 6px 12px; }
    .pc-f, input.pc-f { width: 100%; min-height: 44px; min-width: 0; field-sizing: fixed; }
    .pc-w:has([aria-invalid='true']) { margin-bottom: 28px; }
    .pc-foot { flex-direction: column; align-items: stretch; gap: 18px; margin-top: 28px; }
    .pc-btn { width: 100%; }
    .pc-err { white-space: normal; }
    .pc-ok p { font-size: 22px; }
  }
</style>
