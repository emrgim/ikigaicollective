# Public (shipped to the browser). Google Meet link for live Lab Night mode. Leave empty to hide the "Join now" button.
PUBLIC_MEET_URL=
# Build-time. Override the Substack link if needed.
SUBSTACK_URL=https://ikigaicollective.substack.com/
# Set to "production" at cutover. Anything else: noindex, robots.txt disallows all, forms send nothing.
PUBLIC_SITE_ENV=preview

# Server-only (Vercel env, never PUBLIC_). Phase 5 integrations. Unset = endpoints return 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
LAB_NIGHT_EVENT_ID=
LAB_NIGHT_EVENT_ID_PREVIEW=
SHEET_ID=
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOOP_CHANNEL_ID=
DISCORD_WEBSITE_TAG_ID=
CRON_SECRET=
GITHUB_CONTENT_TOKEN=
# Optional: GITHUB_REPO=owner/repo  GITHUB_BRANCH=site-v2
# Public, off by default: 1 = forms call the real API in preview (test event, '-test' tabs).
PUBLIC_FORMS_LIVE=

# Public. Named contact on the privacy page.
PUBLIC_PRIVACY_EMAIL=
# Public. Discord feedback thread; shows the "Preview" banner on the non-live site.
PUBLIC_PREVIEW_FEEDBACK_URL=
